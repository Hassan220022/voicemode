# VoiceMode + OpenAI-compatible proxy (9router) template — placeholders only
# Docs (9router): base URL https://YOUR-9ROUTER-HOST/v1
#   POST /v1/audio/speech
#   POST /v1/audio/transcriptions
#   GET  /v1/models
#   GET  /v1/audio/voices?provider=edge-tts|deepgram|elevenlabs|inworld|local-device
# OPENAI_API_KEY holds the 9router dashboard Bearer token (OpenAI client compat).
OPENAI_API_KEY=YOUR_9ROUTER_API_KEY
VOICEMODE_9ROUTER_ONLY=true
VOICEMODE_TTS_BASE_URLS=https://YOUR-9ROUTER-HOST/v1
VOICEMODE_STT_BASE_URLS=https://YOUR-9ROUTER-HOST/v1
# Working on this gateway when edge-tts + deepgram providers are enabled:
VOICEMODE_TTS_MODEL=edge-tts/en-US-AriaNeural
VOICEMODE_STT_MODEL=deepgram/nova-2
VOICEMODE_TTS_MODELS=edge-tts/en-US-AriaNeural
VOICEMODE_TTS_VOICE=alloy
VOICEMODE_VOICES=alloy
VOICEMODE_PREFER_LOCAL=false
VOICEMODE_AUTO_START_SERVICES=false
VOICEMODE_AUTO_START_KOKORO=false
