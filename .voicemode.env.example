# VoiceMode environment template (placeholders only — never commit real secrets).
# Copy to ~/.voicemode/voicemode.env (or ./.voicemode.env) and fill in values.
# Real files named .voicemode.env / .env are gitignored.

#############
# OmniRoute-only backend (strict OpenAI-compatible proxy)
#############
# OmniRoute must expose OpenAI-compatible:
#   POST /v1/audio/speech
#   POST /v1/audio/transcriptions
#
# OPENAI_API_KEY is the Bearer credential variable used by the OpenAI client
# library. Set it to your OmniRoute API key (not an OpenAI cloud key).
OPENAI_API_KEY=YOUR_OMNIROUTE_API_KEY

VOICEMODE_OMNIROUTE_ONLY=true
VOICEMODE_TTS_BASE_URLS=https://YOUR-OMNIROUTE-HOST/v1
VOICEMODE_STT_BASE_URLS=https://YOUR-OMNIROUTE-HOST/v1
VOICEMODE_TTS_MODEL=tts-1
VOICEMODE_STT_MODEL=whisper-1
VOICEMODE_TTS_VOICE=alloy
VOICEMODE_VOICES=alloy
VOICEMODE_PREFER_LOCAL=false
VOICEMODE_AUTO_START_SERVICES=false

# Optional: also disable the Kokoro-specific auto-start flag explicitly
# VOICEMODE_AUTO_START_KOKORO=false
